# CMake build artifacts (build-<project>/ is created by `holoscan test`)
build/
/build-*/
.cmake/

# Caller-owned Python environments
.venv/

# Container HOME-mapped junk (dev container sets HOME=/workspace/deltacast)
.local/
.cupy/
.cache/
.bash_history
.python_history
.ngc/
.nv/

# Fetched test data (downloaded by the endoscopy_data CMake target)
data/
/data-*/

# Python packaging artifacts
dist/
*.egg-info/
__pycache__/
*.py[cod]

# Editor / IDE
.vscode/
.idea/
*.swp
